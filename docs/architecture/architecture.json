  "cards": [
    {
      "dot": "amber",
      "title": "Planned, not built",
      "items": [
        "Order events: a Service Bus topic. Orders publishes 'order confirmed' and Catalog listens to update the stock count (stock is part of v1)",
        "Event stream: Kafka for analytics. Orders also streams all order events to it, and an Analytics consumer reads them",
        "Later and not drawn: job done or failed events, catalog change events, a VAT e-invoice service (SIE-96)"
      ]
    },
    {
      "dot": "slate",
      "title": "Not drawn",
      "items": [
        "All services run on Azure Container Apps, defined in Terraform",
        "All services send logs and traces to Application Insights",
        "Keycloak uses its own database on the same PostgreSQL server",
        "Jobs API and AI worker are one service (AI and jobs) sharing the jobs schema"
      ]
    },
    {
      "dot": "cyan",
      "title": "Data and trust",
      "items": [
        "One PostgreSQL server, one schema and one database user per service (ADR 0005)",
        "Gemini calls leave Azure (ADR 0006, 0007)",
        "Original media is deleted 30 days after extraction, or after upload if never extracted (ADR 0007)",
        "Open items are in docs/reverify.md"
      ]
    }
  ]
