  "cards": [
    {
      "dot": "emerald",
      "title": "Async by design",
      "items": [
        "The upload returns a job ID at once",
        "Extraction runs in the background",
        "Results arrive by polling, not push",
        "Polling goes through the gateway to the Jobs API"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure path",
      "items": [
        "A job is marked done only after Orders accepts the order",
        "Until then the queue redelivers it and the worker retries",
        "The job ID makes a retry safe"
      ]
    },
    {
      "dot": "slate",
      "title": "Scope",
      "items": [
        "Voice flow only; a scan follows the same path with an image",
        "Reviewing and confirming the order is the normal orders flow, not drawn here",
        "Jobs API and AI worker are one service (AI and jobs)"
      ]
    }
